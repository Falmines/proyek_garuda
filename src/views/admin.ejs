<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ADMIN PANEL</span><h1>Dashboard Informasi Proyek</h1><p>Login sebagai <b><%= user.username %></b> · <a href="/admin/logout">Logout</a></p></section><section class="section"><h2>Kelola Proyek</h2><div class="admin-grid"><% projects.forEach(p=>{ %><form class="admin-card" method="post" action="/admin/project/<%= p.id %>"><img src="<%= p.image %>"><input name="title" value="<%= p.title %>"><input name="category" value="<%= p.category %>"><textarea name="summary" rows="3"><%= p.summary %></textarea><textarea name="description" rows="4"><%= p.description %></textarea><input name="status" value="<%= p.status %>"><label>Progres (%)</label><input type="number" min="0" max="100" name="progress" value="<%= p.progress %>"><button class="btn">Simpan Perubahan</button></form><% }) %></div></section><section class="section"><h2>Pesan Masuk</h2><div class="table-wrap"><table><thead><tr><th>Nama</th><th>Kontak</th><th>Subjek</th><th>Pesan</th><th>Waktu</th></tr></thead><tbody><% messages.forEach(m=>{ %><tr><td><%= m.name %></td><td><%= m.phone||m.email||'-' %></td><td><%= m.subject||'-' %></td><td><%= m.message %></td><td><%= new Date(m.created_at).toLocaleString('id-ID') %></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>

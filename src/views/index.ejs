    <a href="#<%= batch.id %>"><%= batch.name %></a>
    <% }) %>
  </nav>
  <% helicopterBatches.forEach(batch => { %>
  <section class="helicopter-batch" id="<%= batch.id %>" aria-labelledby="<%= batch.id %>-title">
